  "type_changes": [
    {
      "schema_name": "Response",
      "path": "",
      "old_type": "dict",
      "new_type": "pydantic BaseModel",
      "notes": "Response objects are now pydantic models and no longer conform to the dictionary shape. Use attribute access: `completion.choices[0].text`, `completion.choices[0].message.content`, `dict(completion).get('usage')`; convert with `model.model_dump()` and `completion.model_dump_json(indent=2)` instead of `completion['choices'][0]['text']`, `completion.get('usage')`, `json.dumps(completion)`"
    },
    {
      "schema_name": "PaginatedList",
      "path": "",
      "old_type": "paginated response requiring `.auto_paging_iter()`",
      "new_type": "auto-iterable paginated response",
      "notes": "All `list()` methods that support pagination in the API now support automatic iteration, for example: `for job in client.fine_tuning.jobs.list(limit=1):`. Previously you would have to explicitly call a `.auto_paging_iter()` method instead."
    },
    {
      "schema_name": "OpenAI",
      "path": "client",
      "old_type": "global module state",
      "new_type": "OpenAI client instance",
      "notes": "Switch to explicit client instantiation: `client = OpenAI(api_key=os.environ['OPENAI_API_KEY'])` instead of `openai.api_key = os.environ['OPENAI_API_KEY']`. Global `openai.api_key`, `openai.base_url`, `openai.default_headers` with `openai.chat.completions.create(...)` remains only for REPLs/notebooks, not application code."
    }
  ],
  "value_changes": [],
  "target_dependency": {
    "name": "openai",
