+def test_negated_quaternion_gives_same_rotation(frames):
+    import dataclasses
+
+    pose = frames["amr-03"].pose
+    assert pose.qw < 0  # the fixture carries a negative-qw quaternion, heading 359 deg
+    assert heading_deg(pose) == pytest.approx(359.0)
+    neg = dataclasses.replace(pose, qx=-pose.qx, qy=-pose.qy, qz=-pose.qz, qw=-pose.qw)
+    assert np.allclose(rotation_matrix(neg), rotation_matrix(pose))
+    assert heading_deg(neg) == pytest.approx(heading_deg(pose))
+    assert tilt_deg(neg) == pytest.approx(tilt_deg(pose))
