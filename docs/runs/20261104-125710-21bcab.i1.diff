+    n = math.sqrt(pose.qx**2 + pose.qy**2 + pose.qz**2 + pose.qw**2)
+    if not math.isfinite(n) or n <= 0.0:
+        raise ValueError(f"invalid quaternion {(pose.qx, pose.qy, pose.qz, pose.qw)}")
+    return pose.qx / n, pose.qy / n, pose.qz / n, pose.qw / n
