+def test_negated_quaternion_gives_same_rotation(frames):
+    # q and -q are the same rotation: the server does not canonicalise sign.
+    for f in frames.values():
+        p = f.pose
+        neg = Pose(p.x, p.y, p.z, -p.qx, -p.qy, -p.qz, -p.qw)
+        assert np.allclose(rotation_matrix(p), rotation_matrix(neg), atol=1e-12)
+        assert heading_deg(p) == pytest.approx(heading_deg(neg))
+        assert tilt_deg(p) == pytest.approx(tilt_deg(neg))
+    # amr-03 ships a negative qw; heading must still read 359 deg.
+    assert heading_deg(frames["amr-03"].pose) == pytest.approx(359.0)
