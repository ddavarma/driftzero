+    @classmethod
+    def from_euler(
+        cls, x: float, y: float, z: float, roll: float, pitch: float, yaw: float
+    ) -> "Pose":
+        """Build a pose from Euler angles in degrees, intrinsic Z-Y-X.
+
+        Helper for tests and for callers migrating off v1; the library
+        itself always builds rotations from the quaternion directly.
+        """
+        r, p, w = math.radians(roll), math.radians(pitch), math.radians(yaw)
+        cr, sr = math.cos(r / 2.0), math.sin(r / 2.0)
+        cp, sp = math.cos(p / 2.0), math.sin(p / 2.0)
+        cy, sy = math.cos(w / 2.0), math.sin(w / 2.0)
+        return cls(
+            float(x),
+            float(y),
+            float(z),
+            sr * cp * cy - cr * sp * sy,
+            cr * sp * cy + sr * cp * sy,
+            cr * cp * sy - sr * sp * cy,
+            cr * cp * cy + sr * sp * sy,
+        )
+
+    def normalized(self) -> tuple[float, float, float, float]:
+        """Return the (qx, qy, qz, qw) tuple scaled to unit norm."""
+        n = math.sqrt(self.qx**2 + self.qy**2 + self.qz**2 + self.qw**2)
+        if n <= 0.0 or not math.isfinite(n):
+            raise ValueError(f"degenerate quaternion {(self.qx, self.qy, self.qz, self.qw)!r}")
+        return (self.qx / n, self.qy / n, self.qz / n, self.qw / n)
+
+    def _euler_deg(self) -> tuple[float, float, float]:
+        """Roll, pitch, yaw in degrees derived from the quaternion."""
+        from fleet_telemetry.orientation import rotation_matrix
+
+        r = rotation_matrix(self)
+        pitch = math.degrees(math.asin(max(-1.0, min(1.0, -r[2, 0]))))
+        roll = math.degrees(math.atan2(r[2, 1], r[2, 2]))
+        yaw = math.degrees(math.atan2(r[1, 0], r[0, 0])) % 360.0
+        return (roll, pitch, yaw)
+
+    @property
+    def roll(self) -> float:
+        """Derived roll in degrees (intrinsic Z-Y-X)."""
+        return self._euler_deg()[0]
+
+    @property
+    def pitch(self) -> float:
+        """Derived pitch in degrees (intrinsic Z-Y-X)."""
+        return self._euler_deg()[1]
+
+    @property
+    def yaw(self) -> float:
+        """Derived yaw/heading in degrees, normalised to [0, 360)."""
+        return self._euler_deg()[2]
 
 
