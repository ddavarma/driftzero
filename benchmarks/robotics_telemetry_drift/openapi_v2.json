  "components": {
    "schemas": {
      "Position": {
        "type": "object",
        "required": [
          "x",
          "y",
          "z"
        ],
        "additionalProperties": false,
        "description": "Position in the fleet map frame, metres.",
        "properties": {
          "x": {
            "type": "number",
            "format": "double"
          },
          "y": {
            "type": "number",
            "format": "double"
          },
          "z": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "TelemetryFrame": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "robot_id",
          "timestamp",
          "position",
          "orientation",
          "covariance",
          "health",
          "battery"
        ],
        "properties": {
          "robot_id": {
            "type": "string",
            "example": "amr-01"
          },
          "timestamp": {
            "type": "number",
            "format": "double",
            "description": "Unix seconds."
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "battery": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "State of charge, 0..1."
          },
          "orientation": {
            "$ref": "#/components/schemas/Quaternion"
          },
          "covariance": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "number"
              }
            },
            "description": "6x6 symmetric pose covariance, row-major nested arrays. Variable order: x, y, z (m), rotation about X, Y, Z (rad). Position block is [0:3, 0:3] in m^2."
          },
          "health": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Composite localisation/drive health score from the on-robot monitor. 1 = nominal. Values below 0.5 indicate the robot should be serviced."
          }
        }
      },
      "FleetSnapshot": {
        "type": "object",
        "required": [
          "api_version",
          "frames"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "const": "v2"
          },
          "generated_at": {
            "type": "number",
            "description": "Unix seconds."
          },
          "frames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TelemetryFrame"
            }
          }
        }
      },
      "Quaternion": {
        "type": "object",
        "required": [
          "qx",
          "qy",
          "qz",
          "qw"
        ],
        "additionalProperties": false,
        "description": "Unit quaternion (Hamilton convention, scalar-last) giving the body-to-map rotation. Server guarantees |q| = 1 within 1e-6; q and -q are the same rotation.",
        "properties": {
          "qx": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "qy": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "qz": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "qw": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      }
    }
  }
}
